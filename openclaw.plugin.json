{
  "id": "patchright-stealth",
  "name": "Patchright Stealth Browser",
  "description": "Interactive stealth browser via Patchright (real Chrome, persistent profile, isolated per agent). Use for bot-detected sites (DataDome/Cloudflare/Akamai). Separate from OpenClaw's native browser tool.",
  "version": "0.4.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "proxies": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "required": [
              "server"
            ],
            "properties": {
              "server": {
                "type": "string",
                "description": "Proxy URL, e.g. http://host:port or socks5://host:port."
              },
              "username": {
                "type": "string"
              },
              "passwordEnv": {
                "type": "string",
                "description": "Name of a gateway environment variable that holds the proxy password."
              },
              "bypass": {
                "type": "string",
                "description": "Comma-separated hosts to bypass the proxy for."
              }
            },
            "additionalProperties": false
          }
        },
        "description": "Named proxy profiles that agents select with stealth_open { proxyProfile }."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "skills": [
    "./skills"
  ],
  "contracts": {
    "tools": [
      "stealth_open",
      "stealth_navigate",
      "stealth_content",
      "stealth_click",
      "stealth_fill",
      "stealth_type",
      "stealth_press",
      "stealth_wait",
      "stealth_evaluate",
      "stealth_screenshot",
      "stealth_box",
      "stealth_mouse_move",
      "stealth_mouse_button",
      "stealth_drag",
      "stealth_hover",
      "stealth_cookies_get",
      "stealth_cookies_set",
      "stealth_cookies_clear",
      "stealth_status",
      "stealth_close"
    ]
  }
}
